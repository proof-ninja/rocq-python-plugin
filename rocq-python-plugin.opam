# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Python extraction plugin for Rocq"
maintainer: ["Yoshihiro Imai"]
authors: ["Yoshihiro Imai"]
license: "MIT"
homepage: "https://github.com/proof-ninja/rocq-python-plugin"
bug-reports: "https://github.com/proof-ninja/rocq-python-plugin/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml"
  "rocq-runtime" {>= "9.4~"}
  "rocq-core" {>= "9.4~"}
  "rocq-stdlib" {>= "9.4~"}
  "rocq-pycert"
  "zarith"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/proof-ninja/rocq-python-plugin.git"
x-maintenance-intent: ["(latest)"]
# rocq-pycert は opam リポジトリに未公開なので、GitHub のものをピンして使う。
# dune-projectから自動生成される.opamは *.opam.templateファイルがある場合勝手にそれを含める
pin-depends: [
  ["rocq-pycert.dev" "git+https://github.com/proof-ninja/PyCert.git"]
]
